{
  "name": "opencode-prompt-suggestion-plugin",
  "version": "0.1.0",
  "description": "Suggest the next prompt after each turn (Claude Code style ghost text, Tab to accept) for the OpenCode TUI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALCyllene/OpencodePromptSuggestionPlugin.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "prompt",
    "suggestion",
    "ghost-text"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@opencode/plugin": "2.2.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/theme": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "22.13.10",
    "solid-js": "1.9.17",
    "typescript": "5.8.2"
  }
}
